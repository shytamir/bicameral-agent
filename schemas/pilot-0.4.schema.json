        "task": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "ACTION": "#/$defs/Action",
                  "OUTCOME": "#/$defs/Outcome",
                  "POLICY": "#/$defs/Policy",
                  "RETRIEVE": "#/$defs/Retrieve"
