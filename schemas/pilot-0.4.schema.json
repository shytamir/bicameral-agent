          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "const": "EVENT",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "event_id"
      ],
      "title": "EventQuery",
      "type": "object"
    },
    "InvariantUpdate": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "minLength": 1,
          "title": "Assessment",
          "type": "string"
        },
        "contradictory": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Contradictory",
          "type": "array"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "INVARIANT",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "CURRENT",
            "RETIRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "supporting": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Supporting",
          "type": "array"
        },
        "wording": {
          "minLength": 1,
          "title": "Wording",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "wording",
        "scope",
        "status",
        "assessment"
      ],
      "title": "InvariantUpdate",
      "type": "object"
    },
    "ItchUpdate": {
      "additionalProperties": false,
      "properties": {
        "discrepancy": {
          "minLength": 1,
