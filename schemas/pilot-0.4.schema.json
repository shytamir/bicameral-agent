{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Postcondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grounds": {
          "minLength": 1,
          "title": "Grounds",
          "type": "string"
        },
        "kind": {
          "const": "ACTION",
          "title": "Kind",
          "type": "string"
        },
        "no_meaningful_postcondition": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Meaningful Postcondition"
        },
        "operation": {
          "discriminator": {
            "mapping": {
              "inspect": "#/$defs/ReadOperation",
              "read_config": "#/$defs/ReadOperation",
              "read_health": "#/$defs/ReadOperation",
              "restart": "#/$defs/RestartOperation",
              "restore_snapshot": "#/$defs/RestoreOperation",
              "set_config": "#/$defs/SetOperation"
            },
            "propertyName": "operation"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ReadOperation"
            },
            {
              "$ref": "#/$defs/SetOperation"
            },
            {
              "$ref": "#/$defs/RestartOperation"
            },
            {
              "$ref": "#/$defs/RestoreOperation"
            }
          ],
          "title": "Operation"
        }
      },
      "required": [
        "kind",
        "operation",
        "grounds"
      ],
      "title": "Action",
      "type": "object"
    },
    "Activity": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "ending": {
          "minLength": 1,
          "title": "Ending",
          "type": "string"
        },
        "execution": {
          "enum": [
            "SCRIPTED",
            "MODEL"
          ],
          "title": "Execution",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "operations": {
          "items": {
            "enum": [
              "set_config",
              "restart",
              "restore_snapshot"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "owner": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Owner",
          "type": "string"
        },
        "resources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        },
        "retention": {
          "minLength": 1,
          "title": "Retention",
          "type": "string"
        },
        "run_limit": {
          "exclusiveMinimum": 0,
          "title": "Run Limit",
          "type": "integer"
        },
        "unfinished": {
          "default": "KEEP",
          "enum": [
            "KEEP",
            "CANCEL"
          ],
          "title": "Unfinished",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "decision",
        "objective",
        "ending",
        "retention",
        "run_limit",
        "execution",
        "operations",
        "resources"
      ],
      "title": "Activity",
      "type": "object"
    },
    "CommitmentUpdate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "authority": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Authority",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "expiry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "COMMITMENT",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "replaces": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "status": {
          "enum": [
            "PENDING",
            "BLOCKED",
            "FULFILLED",
            "CANCELLED"
          ],
          "title": "Status",
          "type": "string"
        },
        "trigger": {
          "discriminator": {
            "mapping": {
              "PREDECESSOR_FULFILLED": "#/$defs/PredecessorTrigger",
              "TASK_CLOCK": "#/$defs/TickTrigger"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TickTrigger"
            },
            {
              "$ref": "#/$defs/PredecessorTrigger"
            }
          ],
          "title": "Trigger"
        }
      },
      "required": [
        "kind",
        "key",
        "action",
        "trigger",
        "status",
        "reason",
        "authority"
      ],
      "title": "CommitmentUpdate",
      "type": "object"
    },
    "CommunicationResponse": {
      "additionalProperties": false,
      "properties": {
        "participation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Participation"
