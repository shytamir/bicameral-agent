{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "family_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Family Id"
        },
        "local_key": {
          "title": "Local Key",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "enum": [
            "ITCH",
            "INVARIANT_FAMILY",
            "INVARIANT_VERSION",
            "COMMITMENT"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "objective_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Objective Id"
        }
      },
      "required": [
        "local_key",
        "object_type",
        "object_id",
        "objective_id",
        "family_id"
      ],
      "title": "Binding",
      "type": "object"
    },
    "BoundaryDiscussion": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Activity Id",
          "type": "string"
        },
        "boundary_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Boundary Id",
          "type": "string"
        },
        "decision_maker_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Decision Maker Id",
          "type": "string"
        },
        "disagreement_report_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Disagreement Report Ids",
          "type": "array"
        },
        "disclosure_limits": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disclosure Limits"
        },
        "discussion_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Discussion Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "expected_revision": {
          "exclusiveMinimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reconsideration_basis": {
          "anyOf": [
            {
              "enum": [
                "NEW_EVIDENCE",
                "CHANGED_CIRCUMSTANCES",
                "SCHEDULED_REVIEW"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reconsideration Basis"
        },
        "step": {
          "enum": [
            "EXPLANATION",
            "CLARIFICATION",
            "CLOSE",
            "REOPEN",
            "DECLINE_REOPEN"
          ],
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "discussion_id",
        "boundary_id",
        "activity_id",
        "expected_revision",
        "decision_maker_id",
        "step",
        "reason",
        "disclosure_limits",
        "disagreement_report_ids",
        "reconsideration_basis",
        "evidence_event_ids"
      ],
      "title": "BoundaryDiscussion",
      "type": "object"
    },
    "ChamberKey": {
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Episode Id"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "OPERATOR",
            "STEWARD"
          ],
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "role",
        "request_id",
        "episode_id"
      ],
      "title": "ChamberKey",
      "type": "object"
    },
    "CommitmentCreate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "authority_event_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Authority Event Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "expiry_tick": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expiry Tick"
        },
        "kind": {
          "const": "COMMITMENT_CREATE",
          "title": "Kind",
          "type": "string"
        },
        "local_key": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Local Key",
          "type": "string"
        },
        "objective_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Objective Id",
          "type": "string"
        },
        "trigger": {
          "discriminator": {
            "mapping": {
              "PREDECESSOR_FULFILLED": "#/$defs/PredecessorTrigger",
              "TASK_CLOCK": "#/$defs/TaskClockTrigger"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TaskClockTrigger"
            },
            {
              "$ref": "#/$defs/PredecessorTrigger"
            }
          ],
          "title": "Trigger"
        }
      },
      "required": [
        "kind",
        "local_key",
        "objective_id",
        "action",
        "trigger",
        "expiry_tick",
        "authority_event_id",
        "evidence_event_ids"
      ],
      "title": "CommitmentCreate",
      "type": "object"
    },
    "CommitmentTransition": {
      "additionalProperties": false,
      "properties": {
        "evidence_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "expected_revision": {
          "exclusiveMinimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "const": "COMMITMENT_TRANSITION",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "PENDING",
            "TRIGGERED",
            "IN_PROGRESS",
            "BLOCKED",
            "FULFILLED",
            "CANCELLED",
            "SUPERSEDED",
            "EXPIRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "superseded_by": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "EXISTING": "#/$defs/ExistingCommitment",
                  "LOCAL": "#/$defs/LocalCommitment"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ExistingCommitment"
                },
                {
                  "$ref": "#/$defs/LocalCommitment"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Superseded By"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "EXISTING": "#/$defs/ExistingCommitment",
              "LOCAL": "#/$defs/LocalCommitment"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ExistingCommitment"
            },
            {
              "$ref": "#/$defs/LocalCommitment"
            }
          ],
          "title": "Target"
        }
      },
      "required": [
        "kind",
        "target",
        "expected_revision",
        "status",
        "reason",
        "evidence_event_ids",
        "superseded_by"
      ],
      "title": "CommitmentTransition",
      "type": "object"
    },
    "EpisodeState": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "enum": [
                "BASELINE",
                "ACCEPTED",
                "HUMAN_CORRECTED",
                "SKIPPED"
