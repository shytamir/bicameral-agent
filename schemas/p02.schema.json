            },
            {
              "type": "null"
            }
          ],
          "title": "Disposition"
        },
        "kind": {
          "const": "EPISODE",
          "title": "Kind",
          "type": "string"
        },
        "objective_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Objective Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "OPEN",
            "CONSOLIDATING",
            "RECOVERY_REQUIRED",
            "CLOSED"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "objective_id",
        "phase",
        "disposition"
      ],
      "title": "EpisodeState",
      "type": "object"
    },
    "ExistingCommitment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "EXISTING",
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "const": "COMMITMENT",
          "title": "Object Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_type",
        "object_id"
      ],
      "title": "ExistingCommitment",
      "type": "object"
    },
    "ExistingItch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "EXISTING",
