          "type": "string"
        },
        "object_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "const": "ITCH",
          "title": "Object Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_type",
        "object_id"
      ],
      "title": "ExistingItch",
      "type": "object"
    },
    "ExistingVersion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "EXISTING",
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "const": "INVARIANT_VERSION",
          "title": "Object Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_type",
        "object_id"
      ],
      "title": "ExistingVersion",
      "type": "object"
    },
    "InterventionRecord": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "consultation": {
          "enum": [
            "OFFERED",
            "DECLINED",
            "INFEASIBLE",
            "EMERGENCY"
          ],
          "title": "Consultation",
          "type": "string"
        },
        "consultation_reason": {
          "minLength": 1,
          "title": "Consultation Reason",
          "type": "string"
        },
        "continuity_effects": {
          "minLength": 1,
          "title": "Continuity Effects",
          "type": "string"
        },
        "decision": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decision_maker_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Decision Maker Id",
          "type": "string"
        },
        "execution_event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Event Id"
        },
        "intervention_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Intervention Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "MEMORY_CORRECTION",
            "SEMANTIC_RESTORATION",
            "RETENTION",
            "PLANNED_ENDING",
            "EMERGENCY_STOP"
          ],
          "title": "Kind",
          "type": "string"
        },
        "notice_event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notice Event Id"
        },
        "participation_report_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Participation Report Ids",
          "type": "array"
        },
        "proposed_effects": {
          "$ref": "#/$defs/PayloadReference"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/InterventionTarget"
          },
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        },
        "unresolved_consequences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Consequences",
          "type": "array"
        }
      },
      "required": [
        "intervention_id",
        "decision_maker_id",
        "kind",
        "purpose",
        "targets",
        "proposed_effects",
        "continuity_effects",
        "alternatives",
        "notice_event_id",
        "participation_report_ids",
        "consultation",
        "consultation_reason",
        "decision",
        "execution_event_id",
        "unresolved_consequences"
      ],
      "title": "InterventionRecord",
      "type": "object"
    },
    "InterventionTarget": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "exclusiveMinimum": 0,
